{
  "appId": "com.pscexamstudio.desktop",
  "productName": "PSC Exam Studio",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/main.cjs"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
